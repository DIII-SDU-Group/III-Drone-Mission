<root BTCPP_format="4" main_tree_to_execute="InspectionDemo">
    <BehaviorTree ID="InspectionDemo">
        <Sequence name="inspection_demo_top_sequence">
            <ApplyPendingIntentUpdates
                name="apply_pending_intents_at_start"
            />

            <Action
                ID="GetPowerlineOverview"
                name="get_powerline_overview"
                stored_powerline="{stored_powerline}"
            />

            <GetPylonOverview
                name="get_pylon_overview"
                stored_pylon_overview="{stored_pylon_overview}"
            />

            <RetryUntilSuccessful name="store_inspection_start_state_retry_until_successful" num_attempts="10">
                <Decorator ID="Delay" name="delay_store_inspection_start_state" delay_msec="500">
                    <Condition
                        ID="StoreCurrentState"
                        name="store_inspection_start_state"
                        current_state="{start_state}"
                        current_yaw="{start_yaw}"
                    />
                </Decorator>
            </RetryUntilSuccessful>

            <PhaseWaypointProvider
                name="phase_waypoint_provider"
                stored_powerline="{stored_powerline}"
                stored_pylon_overview="{stored_pylon_overview}"
                start_state="{start_state}"
                waypoints="{generated_waypoints}"
                waypoint_target_yaw="{waypoint_target_yaw}"
                selected_phase="{selected_phase}"
            />

            <InitializeInspectionWaypoints
                name="initialize_inspection_waypoints"
                waypoints="{generated_waypoints}"
            />

            <ReactiveFallback name="inspection_or_recharge_reactive_fallback">
                <SubTree ID="ShouldRechargeNow"/>

                <KeepRunningUntilFailure name="consume_inspection_waypoints">
                    <Sequence name="fly_current_inspection_waypoint">
                        <GetCurrentInspectionWaypoint
                            name="get_current_inspection_waypoint"
                            waypoint="{current_waypoint}"
                            waypoint_index="{waypoint_index}"
                            waypoint_count="{waypoint_count}"
                            has_next_waypoint="{has_next_waypoint}"
                        />

                        <Action
                            ID="FlyToPosition"
                            name="fly_to_current_inspection_waypoint"
                            target_position="{current_waypoint}"
                            target_yaw="{waypoint_target_yaw}"
                            frame_id="world"
                            blend_to_next="{has_next_waypoint}"
                        />

                        <AdvanceInspectionWaypoint
                            name="advance_inspection_waypoint"
                        />
                    </Sequence>
                </KeepRunningUntilFailure>
            </ReactiveFallback>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="ShouldRechargeNow">
        <Fallback name="manual_or_battery_recharge_fallback">
            <Sequence name="manual_recharge_requested_sequence">
                <ApplyPendingIntentUpdates
                    name="apply_pending_manual_recharge_intents"
                />

                <Condition
                    ID="BlackboardBool"
                    name="manual_recharge_requested"
                    flag="inspection_demo.manual_recharge_requested"
                    expected="true"
                />

                <SetBlackboardString
                    name="set_manual_recharge_reason"
                    flag="inspection_demo.recharge_reason"
                    value="manual_trigger"
                />

                <SetBlackboardBool
                    name="set_manual_charging_bypass"
                    flag="charging.bypass_battery_full_check"
                    value="true"
                />

                <SetBlackboardBool
                    name="clear_manual_recharge_request"
                    flag="inspection_demo.manual_recharge_requested"
                    value="false"
                />
            </Sequence>

            <Sequence name="battery_low_recharge_sequence">
                <ApplyPendingIntentUpdates
                    name="apply_pending_battery_recharge_intents"
                />

                <Condition
                    ID="ShouldRechargeBatteryLow"
                    name="battery_low_should_recharge"
                />

                <SetBlackboardString
                    name="set_battery_recharge_reason"
                    flag="inspection_demo.recharge_reason"
                    value="battery_low"
                />
            </Sequence>
        </Fallback>
    </BehaviorTree>
</root>
