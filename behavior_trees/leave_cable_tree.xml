<root BTCPP_format="4" main_tree_to_execute="LeaveCable">
     <BehaviorTree ID="LeaveCable">
        <Sequence name="leave_cable_top_sequence">
           <Action 
                ID="LogMessage" 
                name="log"
                message="Leave cable tree started. Hovering on cable."
                log_level="2"
            />

            <Action
                  ID="Sleep"
                  name="pre_takeoff_wait"
                  msec="1000"
            />

            <Action 
                ID="PLMapperCommand" 
                name="pl_mapper_command_pause" 
                pl_mapper_command="2" 
                reset="false"
            />

            <RetryUntilSuccessful name="arm_on_cable_retry" num_attempts="5">
                <Delay name="delay_arm_on_cable" delay_msec="1000">
                    <Action 
                        ID="ModeExecutorAction" 
                        name="arm_on_cable" 
                        action_request_type="3"
                    />
                </Delay>
            </RetryUntilSuccessful>

            <Action ID="HoverOnCable" name="pre_release_upward_thrust"
                target_cable_id="{@target_cable_id}"
                duration_s="7."
                target_upwards_velocity="2.0"
                stop_maneuver_after_timeout_ms="7000"
            />

            <Action
                  ID="Sleep"
                  name="pre_release_thrust_wait"
                  msec="5000"
            />

            <Action 
                  ID="GripperCommand" 
                  name="gripper_command_open" 
                  gripper_command="0" 
            />

            <Action
                  ID="Sleep"
                  name="wait_for_gripper_release"
                  msec="250"
            />

            <RetryUntilSuccessful
               name="cable_takeoff_retry_until_successful"
               num_attempts="3"
            >
                <Decorator ID="Delay" name="delay_cable_takeoff_retry" delay_msec="500">
                    <Action
                       ID="CableTakeoff"
                       name="cable_takeoff"
                       target_cable_id="{@target_cable_id}"
                    />
                </Decorator>
            </RetryUntilSuccessful>

            <Action
                  ID="Sleep"
                  name="wait_for_in_flight_awareness"
                  msec="1000"
            />

            <Action 
                ID="PLMapperCommand" 
                name="pl_mapper_command_stop" 
                pl_mapper_command="1" 
                reset="true"
            />

            <SubTree 
                ID="FlyToInitPosition"
                initial_state="{@initial_state}"
                initial_yaw="{@initial_yaw}"
                waypoints="{@waypoints_return}"
            />
            
        </Sequence>
     </BehaviorTree>

     <BehaviorTree ID="FlyToInitPosition">
        <Sequence name="fly_to_init_position_sequence">
            <Condition
                ID="PublishPowerlineWaypoints"
                name="publish_powerline_waypoints"
                waypoints="{waypoints}"
                target_yaw="{initial_yaw}"
            />

            <Action
                ID="PartitionPointQueue"
                name="partition_return_waypoints"
                queue="{waypoints}"
                boundary_index="{@return_outside_boundary_index}"
                before="{return_inside_points}"
                through="{return_through_boundary}"
                after="{return_outside_suffix}"
                boundary="{return_outside_boundary}"
                has_boundary="{return_has_outside_boundary}"
            />

            <IfThenElse name="return_by_explicit_corridor_boundary">
                <Condition ID="QueueHasPoints" name="has_return_outside_boundary" queue="{return_outside_boundary}"/>
                <Sequence name="leave_corridor_then_follow_outside_route">
                    <IfThenElse name="stop_at_inside_return_waypoints_if_present">
                        <Condition ID="QueueHasPoints" name="has_inside_return_points" queue="{return_inside_points}"/>
                        <LoopPoint queue="{return_inside_points}" value="{waypoint}">
                            <Action ID="FlyToPosition" name="fly_to_inside_return_waypoint" target_position="{waypoint}" target_yaw="{initial_yaw}" frame_id="world"/>
                        </LoopPoint>
                        <AlwaysSuccess name="no_inside_return_points"/>
                    </IfThenElse>

                    <LoopPoint queue="{return_outside_boundary}" value="{boundary_waypoint}">
                        <Action
                            ID="FlyToPosition"
                            name="fly_to_first_outside_return_waypoint"
                            target_position="{boundary_waypoint}"
                            target_yaw="{initial_yaw}"
                            frame_id="world"
                        />
                    </LoopPoint>

                    <Action
                        ID="FollowWaypointPath"
                        name="follow_outside_return_route_to_initial_position"
                        frame_id="world"
                        waypoints="{return_outside_suffix}"
                        repeat="false"
                        repeat_from_index="0"
                        target_yaw="{initial_yaw}"
                    />
                </Sequence>
                <Sequence name="direct_inside_corridor_return_with_final_tolerance">
                    <Action
                        ID="SplitPointQueue"
                        name="split_direct_return_waypoints"
                        queue="{waypoints}"
                        prefix="{direct_return_prefix}"
                        last="{direct_return_final_waypoint}"
                    />
                    <LoopPoint queue="{direct_return_prefix}" value="{waypoint}">
                        <Action ID="FlyToPosition" name="fly_to_direct_return_waypoint" target_position="{waypoint}" target_yaw="{initial_yaw}" frame_id="world"/>
                    </LoopPoint>
                    <Action
                        ID="FlyToPosition"
                        name="fly_to_direct_return_initial_position"
                        target_position="{direct_return_final_waypoint}"
                        target_yaw="{initial_yaw}"
                        frame_id="world"
                        completion_position_tolerance_m="0.2"
                    />
                </Sequence>
            </IfThenElse>
        </Sequence>
     </BehaviorTree>

 </root>
