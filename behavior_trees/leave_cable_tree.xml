<root BTCPP_format="4" main_tree_to_execute="LeaveCable">
     <BehaviorTree ID="LeaveCable">
        <Sequence name="leave_cable_top_sequence">
           <Action 
                ID="LogMessage" 
                name="log"
                message="Leave cable tree started. Hovering on cable."
                log_level="2"
            />

            <Action
                  ID="Sleep"
                  name="pre_takeoff_wait"
                  msec="1000"
            />

            <Action 
                ID="PLMapperCommand" 
                name="pl_mapper_command_pause" 
                pl_mapper_command="2" 
                reset="false"
            />

            <RetryUntilSuccessful name="arm_on_cable_retry" num_attempts="5">
                <Delay name="delay_arm_on_cable" delay_msec="1000">
                    <Action 
                        ID="ModeExecutorAction" 
                        name="arm_on_cable" 
                        action_request_type="3"
                    />
                </Delay>
            </RetryUntilSuccessful>

            <Action ID="HoverOnCable" name="pre_release_upward_thrust"
                target_cable_id="{@target_cable_id}"
                duration_s="7."
                target_upwards_velocity="2.0"
                stop_maneuver_after_timeout_ms="7000"
            />

            <Action
                  ID="Sleep"
                  name="pre_release_thrust_wait"
                  msec="5000"
            />

            <Action 
                  ID="GripperCommand" 
                  name="gripper_command_open" 
                  gripper_command="0" 
            />

            <Action
                  ID="Sleep"
                  name="wait_for_gripper_release"
                  msec="250"
            />

            <Action
               ID="CableTakeoff"
               name="cable_takeoff"
               target_cable_id="{@target_cable_id}"
            />

            <Action
                  ID="Sleep"
                  name="wait_for_in_flight_awareness"
                  msec="1000"
            />

            <Action 
                ID="PLMapperCommand" 
                name="pl_mapper_command_stop" 
                pl_mapper_command="1" 
                reset="true"
            />

            <SubTree 
                ID="FlyToInitPosition"
                initial_state="{@initial_state}"
                initial_yaw="{@initial_yaw}"
                waypoints="{@waypoints_return}"
            />
            
        </Sequence>
     </BehaviorTree>

     <BehaviorTree ID="FlyToInitPosition">
        <Sequence name="fly_to_init_position_sequence">
            <Condition
                ID="PublishPowerlineWaypoints"
                name="publish_powerline_waypoints"
                waypoints="{waypoints}"
                target_yaw="{initial_yaw}"
            />

            <Action
                ID="SplitPointQueue"
                name="split_return_waypoints"
                queue="{waypoints}"
                prefix="{blend_waypoints}"
                last="{final_waypoint}"
            />

            <LoopPoint queue="{blend_waypoints}" value="{waypoint}">
                <Decorator ID="Delay" name="delay_between_waypoints" delay_msec="100">
                    <Action
                        ID="FlyToPosition"
                        name="fly_to_position"
                        target_position="{waypoint}"
                        target_yaw="{initial_yaw}"
                        frame_id="world"
                        blend_to_next="true"
                    />
                </Decorator>
            </LoopPoint>

            <Action
                ID="FlyToPosition"
                name="fly_to_final_initial_position"
                target_position="{final_waypoint}"
                target_yaw="{initial_yaw}"
                frame_id="world"
                completion_position_tolerance_m="0.2"
            />
        </Sequence>
     </BehaviorTree>

 </root>
