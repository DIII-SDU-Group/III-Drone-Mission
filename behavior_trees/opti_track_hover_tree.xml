<root BTCPP_format="4" main_tree_to_execute="OptiTrackHover">
    <!-- OT Hover (mission opti-track-hover): OptiTrack lab flight basics.

         Precondition: the pilot hands over from a steady hover at least 1.1 m
         above the ground. FlyToPosition rejects targets below
         /control/maneuver_controller/minimum_target_altitude (1.0 m in the
         real parameter set); the climb and the return keep every target at
         or above the takeover altitude. When the sequence ends the mission
         executor selects /mission/mission_done_select_mode (PX4 Hold).

         One recording covers the run; the scope stops it when the mission
         ends or is interrupted. -->
    <BehaviorTree ID="OptiTrackHover">
        <Decorator
            ID="RosbagRecordingScope"
            name="opti_track_hover_rosbag_recording_scope"
            recording_id="opti_track_hover"
            all_topics="false"
            topics="/fmu/out/vehicle_status_v1,
                    /fmu/out/vehicle_odometry,
                    /fmu/out/vehicle_local_position,
                    /fmu/out/vehicle_land_detected,
                    /fmu/out/failsafe_flags,
                    /fmu/out/estimator_status_flags,
                    /fmu/out/timesync_status,
                    /fmu/out/manual_control_setpoint,
                    /fmu/out/vehicle_command_ack,
                    /fmu/in/vehicle_command,
                    /fmu/in/vehicle_command_mode_executor,
                    /fmu/in/trajectory_setpoint,
                    /fmu/in/config_overrides_request,
                    /fmu/in/mode_completed,
                    /fmu/in/vehicle_visual_odometry,
                    /opti_track/pose_relay/health,
                    /control/maneuver_controller/reference,
                    /control/maneuver_controller/reference_mode,
                    /control/maneuver_controller/current_maneuver,
                    /control/maneuver_controller/maneuver_queue,
                    /control/trajectory_generator/trajectory_path,
                    /mission/mission_executor/maneuver_reference_client/reference_mode,
                    /mission/status,
                    /mission/modes/ot_hover/status,
                    /tf,
                    /tf_static,
                    /rosout"
            include_hidden_topics="false"
            owner="mission"
            stop_timeout_sec="10.0"
        >
            <Sequence name="opti_track_hover_sequence">

                <!-- Geometry: offsets from the vehicle in the drone frame
                     (metres). Adapt here. -->
                <SetBlackboard name="set_climb_offset" output_key="climb_offset" value="0,0,0.3"/>
                <SetBlackboard name="set_return_offset" output_key="return_offset" value="0,0,-0.3"/>

                <Action
                    ID="LogMessage"
                    name="log_holding_takeover_position"
                    message="OT Hover: holding the takeover position"
                    log_level="1"
                />

                <Action
                    ID="Hover"
                    name="hold_takeover_position"
                    duration_s="10"
                    sustain_action="true"
                />

                <Action
                    ID="FlyToPosition"
                    name="climb"
                    frame_id="drone"
                    target_position="{climb_offset}"
                    target_yaw="0"
                />

                <Action
                    ID="Hover"
                    name="hover_after_climb"
                    duration_s="5"
                    sustain_action="true"
                />

                <Action
                    ID="FlyToPosition"
                    name="return_to_takeover_altitude"
                    frame_id="drone"
                    target_position="{return_offset}"
                    target_yaw="0"
                />

                <Action
                    ID="Hover"
                    name="hover_after_return"
                    duration_s="5"
                    sustain_action="true"
                />

                <Action
                    ID="LogMessage"
                    name="log_complete"
                    message="OT Hover: complete"
                    log_level="1"
                />

            </Sequence>
        </Decorator>
    </BehaviorTree>
</root>
