<root BTCPP_format="4" main_tree_to_execute="OptiTrackManeuvers">
    <!-- OT Maneuvers (mission opti-track-maneuvers): the OptiTrack lab
         maneuver set around the cage centre.

         1. fly to the centre; 2. stop-and-go box; 3. blended box; 4. yaw
         steps in place; 5. height step; 6. waypoint path; 7. back to the
         centre. When the sequence ends the mission executor selects
         /mission/mission_done_select_mode (PX4 Hold).

         Precondition: the pilot hands over from a steady hover in the cage.
         All targets are in the III world frame "world"; every target and
         waypoint lies at least 1.1 m above the ground (FlyToPosition rejects
         targets below /control/maneuver_controller/minimum_target_altitude).

         One recording covers the run; the scope stops it when the mission
         ends or is interrupted. -->
    <BehaviorTree ID="OptiTrackManeuvers">
        <Decorator
            ID="RosbagRecordingScope"
            name="opti_track_maneuvers_rosbag_recording_scope"
            recording_id="opti_track_maneuvers"
            all_topics="false"
            topics="/fmu/out/vehicle_status_v1,
                    /fmu/out/vehicle_odometry,
                    /fmu/out/vehicle_local_position,
                    /fmu/out/vehicle_land_detected,
                    /fmu/out/failsafe_flags,
                    /fmu/out/estimator_status_flags,
                    /fmu/out/timesync_status,
                    /fmu/out/manual_control_setpoint,
                    /fmu/out/vehicle_command_ack,
                    /fmu/in/vehicle_command,
                    /fmu/in/vehicle_command_mode_executor,
                    /fmu/in/trajectory_setpoint,
                    /fmu/in/config_overrides_request,
                    /fmu/in/mode_completed,
                    /fmu/in/vehicle_visual_odometry,
                    /opti_track/pose_relay/health,
                    /control/maneuver_controller/reference,
                    /control/maneuver_controller/reference_mode,
                    /control/maneuver_controller/current_maneuver,
                    /control/maneuver_controller/maneuver_queue,
                    /control/trajectory_generator/trajectory_path,
                    /mission/mission_executor/maneuver_reference_client/reference_mode,
                    /mission/status,
                    /mission/modes/ot_maneuvers/status,
                    /tf,
                    /tf_static,
                    /rosout"
            include_hidden_topics="false"
            owner="mission"
            stop_timeout_sec="10.0"
        >
            <Sequence name="opti_track_maneuvers_sequence">

                <!-- Geometry: positions "x,y,z" in the world frame (metres),
                     yaw in radians. Adapt to the cage here. -->
                <SetBlackboard name="set_center" output_key="center" value="0,0,1.2"/>
                <SetBlackboard name="set_center_high" output_key="center_high" value="0,0,1.5"/>
                <SetBlackboard name="set_box_corner_1" output_key="box_corner_1" value="0.5,0.5,1.2"/>
                <SetBlackboard name="set_box_corner_2" output_key="box_corner_2" value="-0.5,0.5,1.2"/>
                <SetBlackboard name="set_box_corner_3" output_key="box_corner_3" value="-0.5,-0.5,1.2"/>
                <SetBlackboard name="set_box_corner_4" output_key="box_corner_4" value="0.5,-0.5,1.2"/>
                <SetBlackboard
                    name="set_box_waypoints"
                    output_key="box_waypoints"
                    value="0.5,0.5,1.2; -0.5,0.5,1.2; -0.5,-0.5,1.2; 0.5,-0.5,1.2"
                />
                <SetBlackboard
                    name="set_path_waypoints"
                    output_key="path_waypoints"
                    value="0.5,0,1.2; 0,0.5,1.4; -0.5,0,1.2; 0,-0.5,1.1; 0.5,0,1.2"
                />
                <SetBlackboard name="set_yaw_zero" output_key="yaw_zero" value="0"/>
                <SetBlackboard name="set_yaw_quarter" output_key="yaw_quarter" value="1.5707963"/>
                <SetBlackboard name="set_yaw_half" output_key="yaw_half" value="3.1415927"/>
                <SetBlackboard name="set_yaw_minus_quarter" output_key="yaw_minus_quarter" value="-1.5707963"/>

                <Action
                    ID="LogMessage"
                    name="log_start"
                    message="OT Maneuvers: flying to the centre"
                    log_level="1"
                />

                <!-- 1. Centre -->
                <Action ID="FlyToPosition" name="fly_to_center" frame_id="world" target_position="{center}" target_yaw="{yaw_zero}"/>
                <Action ID="Hover" name="hover_at_center" duration_s="3" sustain_action="true"/>

                <!-- 2. Stop-and-go box -->
                <Action ID="LogMessage" name="log_stop_and_go_box" message="OT Maneuvers: stop-and-go box" log_level="1"/>
                <Action ID="FlyToPosition" name="stop_and_go_to_corner_1" frame_id="world" target_position="{box_corner_1}" target_yaw="{yaw_zero}"/>
                <Action ID="Hover" name="hover_at_corner_1" duration_s="2" sustain_action="true"/>
                <Action ID="FlyToPosition" name="stop_and_go_to_corner_2" frame_id="world" target_position="{box_corner_2}" target_yaw="{yaw_zero}"/>
                <Action ID="Hover" name="hover_at_corner_2" duration_s="2" sustain_action="true"/>
                <Action ID="FlyToPosition" name="stop_and_go_to_corner_3" frame_id="world" target_position="{box_corner_3}" target_yaw="{yaw_zero}"/>
                <Action ID="Hover" name="hover_at_corner_3" duration_s="2" sustain_action="true"/>
                <Action ID="FlyToPosition" name="stop_and_go_to_corner_4" frame_id="world" target_position="{box_corner_4}" target_yaw="{yaw_zero}"/>
                <Action ID="Hover" name="hover_at_corner_4" duration_s="2" sustain_action="true"/>
                <Action ID="FlyToPosition" name="stop_and_go_to_center" frame_id="world" target_position="{center}" target_yaw="{yaw_zero}"/>
                <Action ID="Hover" name="hover_after_stop_and_go_box" duration_s="3" sustain_action="true"/>

                <!-- 3. Blended box: one waypoint path through the corners, blended
                     at corners 1 to 3 and stopping at corner 4 -->
                <Action ID="LogMessage" name="log_blended_box" message="OT Maneuvers: blended box" log_level="1"/>
                <Action
                    ID="FollowWaypointPath"
                    name="blend_through_the_box_corners"
                    frame_id="world"
                    waypoints="{box_waypoints}"
                    repeat="false"
                    target_yaw="{yaw_zero}"
                    nominal_speed_m_s="0.3"
                    blend_radius_m="0.2"
                />
                <Action ID="FlyToPosition" name="blended_box_to_center" frame_id="world" target_position="{center}" target_yaw="{yaw_zero}"/>
                <Action ID="Hover" name="hover_after_blended_box" duration_s="3" sustain_action="true"/>

                <!-- 4. Yaw steps in place -->
                <Action ID="LogMessage" name="log_yaw_steps" message="OT Maneuvers: yaw steps" log_level="1"/>
                <Action ID="FlyToPosition" name="yaw_to_quarter" frame_id="world" target_position="{center}" target_yaw="{yaw_quarter}"/>
                <Action ID="Hover" name="hover_at_yaw_quarter" duration_s="2" sustain_action="true"/>
                <Action ID="FlyToPosition" name="yaw_to_half" frame_id="world" target_position="{center}" target_yaw="{yaw_half}"/>
                <Action ID="Hover" name="hover_at_yaw_half" duration_s="2" sustain_action="true"/>
                <Action ID="FlyToPosition" name="yaw_to_minus_quarter" frame_id="world" target_position="{center}" target_yaw="{yaw_minus_quarter}"/>
                <Action ID="Hover" name="hover_at_yaw_minus_quarter" duration_s="2" sustain_action="true"/>
                <Action ID="FlyToPosition" name="yaw_to_zero" frame_id="world" target_position="{center}" target_yaw="{yaw_zero}"/>
                <Action ID="Hover" name="hover_at_yaw_zero" duration_s="2" sustain_action="true"/>

                <!-- 5. Height step -->
                <Action ID="LogMessage" name="log_height_step" message="OT Maneuvers: height step" log_level="1"/>
                <Action ID="FlyToPosition" name="climb_to_center_high" frame_id="world" target_position="{center_high}" target_yaw="{yaw_zero}"/>
                <Action ID="Hover" name="hover_at_center_high" duration_s="2" sustain_action="true"/>
                <Action ID="FlyToPosition" name="descend_to_center" frame_id="world" target_position="{center}" target_yaw="{yaw_zero}"/>
                <Action ID="Hover" name="hover_after_height_step" duration_s="2" sustain_action="true"/>

                <!-- 6. Waypoint path, flown once -->
                <Action ID="LogMessage" name="log_waypoint_path" message="OT Maneuvers: waypoint path" log_level="1"/>
                <Action
                    ID="FollowWaypointPath"
                    name="follow_path_waypoints"
                    frame_id="world"
                    waypoints="{path_waypoints}"
                    repeat="false"
                    target_yaw="{yaw_zero}"
                    nominal_speed_m_s="0.3"
                    blend_radius_m="0.2"
                />

                <!-- 7. Back to the centre -->
                <Action ID="FlyToPosition" name="return_to_center" frame_id="world" target_position="{center}" target_yaw="{yaw_zero}"/>
                <Action ID="Hover" name="hover_before_completion" duration_s="5" sustain_action="true"/>

                <Action ID="LogMessage" name="log_complete" message="OT Maneuvers: complete" log_level="1"/>

            </Sequence>
        </Decorator>
    </BehaviorTree>
</root>
