<root BTCPP_format="4" main_tree_to_execute="OptiTrackCycleShuttle">
    <!-- OT Shuttle (mission opti-track-cycle): shuttle across the cage and
         back to the centre, turning to face the direction of travel.

         When OT Takeoff set opti_track.cycle_land_now (no Proceed within
         60 s) the shuttle is skipped and the mission continues with OT Land.
         The shuttle also flies when the flag is absent, e.g. when this mode
         is selected directly. -->
    <BehaviorTree ID="OptiTrackCycleShuttle">
        <Sequence name="ot_cycle_shuttle_sequence">

            <!-- Geometry: world frame (metres), yaw in radians. Adapt to the
                 cage here. -->
            <SetBlackboard name="set_shuttle_positive_end" output_key="shuttle_positive_end" value="0.6,0,1.2"/>
            <SetBlackboard name="set_shuttle_negative_end" output_key="shuttle_negative_end" value="-0.6,0,1.2"/>
            <SetBlackboard name="set_cycle_center" output_key="cycle_center" value="0,0,1.2"/>
            <SetBlackboard name="set_yaw_zero" output_key="yaw_zero" value="0"/>
            <SetBlackboard name="set_yaw_half" output_key="yaw_half" value="3.1415927"/>

            <!-- Reuses the run's recording (or starts one when this mode is
                 selected directly). -->
            <StartRosbagRecording
                name="ensure_cycle_recording"
                recording_id="opti_track_cycle"
                all_topics="false"
                topics="/fmu/out/vehicle_status_v1,
                        /fmu/out/vehicle_odometry,
                        /fmu/out/vehicle_local_position,
                        /fmu/out/vehicle_land_detected,
                        /fmu/out/failsafe_flags,
                        /fmu/out/estimator_status_flags,
                        /fmu/out/timesync_status,
                        /fmu/out/manual_control_setpoint,
                        /fmu/out/vehicle_command_ack,
                        /fmu/in/vehicle_command,
                        /fmu/in/vehicle_command_mode_executor,
                        /fmu/in/trajectory_setpoint,
                        /fmu/in/config_overrides_request,
                        /fmu/in/mode_completed,
                        /fmu/in/vehicle_visual_odometry,
                        /opti_track/pose_relay/health,
                        /control/maneuver_controller/reference,
                        /control/maneuver_controller/reference_mode,
                        /control/maneuver_controller/current_maneuver,
                        /control/maneuver_controller/maneuver_queue,
                        /control/trajectory_generator/trajectory_path,
                        /mission/mission_executor/maneuver_reference_client/reference_mode,
                        /mission/status,
                        /mission/modes/ot_cycle_takeoff/status,
                        /mission/modes/ot_cycle_shuttle/status,
                        /mission/modes/ot_cycle_land/status,
                        /tf,
                        /tf_static,
                        /rosout"
                include_hidden_topics="false"
                owner="mission"
            />

            <Fallback name="skip_or_fly_shuttle">
                <Sequence name="skip_shuttle_and_land">
                    <BlackboardBool name="cycle_land_now_requested" flag="opti_track.cycle_land_now" expected="true"/>
                    <Action
                        ID="LogMessage"
                        name="log_skipping_shuttle"
                        message="OT Shuttle: no Proceed, skipping the shuttle"
                        log_level="1"
                    />
                </Sequence>
                <Sequence name="fly_shuttle">
                    <Action ID="FlyToPosition" name="fly_to_positive_end" frame_id="world" target_position="{shuttle_positive_end}" target_yaw="{yaw_zero}"/>
                    <Action ID="Hover" name="hover_at_positive_end" duration_s="2" sustain_action="true"/>
                    <Action ID="FlyToPosition" name="fly_to_negative_end" frame_id="world" target_position="{shuttle_negative_end}" target_yaw="{yaw_half}"/>
                    <Action ID="Hover" name="hover_at_negative_end" duration_s="2" sustain_action="true"/>
                    <Action ID="FlyToPosition" name="return_to_cycle_center" frame_id="world" target_position="{cycle_center}" target_yaw="{yaw_zero}"/>
                    <Action ID="Hover" name="hover_at_cycle_center" duration_s="3" sustain_action="true"/>
                </Sequence>
            </Fallback>

        </Sequence>
    </BehaviorTree>
</root>
