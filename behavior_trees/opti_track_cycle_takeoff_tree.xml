<root BTCPP_format="4" main_tree_to_execute="OptiTrackCycleTakeoff">
    <!-- OT Takeoff (mission opti-track-cycle, executor-owned mode).

         The mission executor arms a disarmed vehicle when this mode is
         selected. On the ground the tree requests a takeoff; when PX4
         already reports the vehicle airborne it skips the takeoff. Without a
         global position PX4 climbs to its default takeoff altitude
         (MIS_TAKEOFF_ALT) instead of the requested one.

         The vehicle then hovers at the cage centre until the operator's
         Proceed intent (/mission/opti_track/proceed), for at most 60 s. On
         Proceed the hover is halted and the mission continues with OT
         Shuttle. Without Proceed it sets opti_track.cycle_land_now: OT
         Shuttle then skips the shuttle and OT Land lands.

         The recording started here (owner "mission") covers every mode of
         the run; the runtime finalizes it once PX4 takes control, as for the
         canonical inspection recording. -->
    <BehaviorTree ID="OptiTrackCycleTakeoff">
        <Sequence name="ot_cycle_takeoff_sequence">

            <!-- Geometry: world frame (metres), yaw in radians. Adapt to the
                 cage here. -->
            <SetBlackboard name="set_takeoff_altitude" output_key="takeoff_altitude" value="1.2"/>
            <SetBlackboard name="set_cycle_center" output_key="cycle_center" value="0,0,1.2"/>
            <SetBlackboard name="set_yaw_zero" output_key="yaw_zero" value="0"/>

            <StartRosbagRecording
                name="start_cycle_recording"
                recording_id="opti_track_cycle"
                all_topics="false"
                topics="/fmu/out/vehicle_status_v1,
                        /fmu/out/vehicle_odometry,
                        /fmu/out/vehicle_local_position,
                        /fmu/out/vehicle_land_detected,
                        /fmu/out/failsafe_flags,
                        /fmu/out/estimator_status_flags,
                        /fmu/out/timesync_status,
                        /fmu/out/manual_control_setpoint,
                        /fmu/out/vehicle_command_ack,
                        /fmu/in/vehicle_command,
                        /fmu/in/vehicle_command_mode_executor,
                        /fmu/in/trajectory_setpoint,
                        /fmu/in/config_overrides_request,
                        /fmu/in/mode_completed,
                        /fmu/in/vehicle_visual_odometry,
                        /opti_track/pose_relay/health,
                        /control/maneuver_controller/reference,
                        /control/maneuver_controller/reference_mode,
                        /control/maneuver_controller/current_maneuver,
                        /control/maneuver_controller/maneuver_queue,
                        /control/trajectory_generator/trajectory_path,
                        /mission/mission_executor/maneuver_reference_client/reference_mode,
                        /mission/status,
                        /mission/modes/ot_cycle_takeoff/status,
                        /mission/modes/ot_cycle_shuttle/status,
                        /mission/modes/ot_cycle_land/status,
                        /tf,
                        /tf_static,
                        /rosout"
                include_hidden_topics="false"
                owner="mission"
            />

            <!-- Start every run from cleared flags. A Proceed the operator
                 sends during the takeoff stays queued and applies below. -->
            <SetBlackboardBool name="clear_proceed" flag="opti_track.proceed" value="false"/>
            <SetBlackboardBool name="clear_cycle_land_now" flag="opti_track.cycle_land_now" value="false"/>

            <Fallback name="take_off_unless_airborne">
                <Action
                    ID="WaitForPX4Airborne"
                    name="already_airborne"
                    hold_ms="500"
                    timeout_ms="1500"
                />
                <Sequence name="take_off_from_the_ground">
                    <Action
                        ID="LogMessage"
                        name="log_taking_off"
                        message="OT Takeoff: on the ground, taking off"
                        log_level="1"
                    />
                    <Action
                        ID="ModeExecutorAction"
                        name="take_off"
                        action_request_type="1"
                        takeoff_altitude="{takeoff_altitude}"
                    />
                    <Action
                        ID="WaitForPX4Airborne"
                        name="airborne_after_takeoff"
                        hold_ms="1000"
                        timeout_ms="8000"
                    />
                </Sequence>
            </Fallback>

            <Action
                ID="FlyToPosition"
                name="fly_to_cycle_center"
                frame_id="world"
                target_position="{cycle_center}"
                target_yaw="{yaw_zero}"
            />

            <Action
                ID="LogMessage"
                name="log_waiting_for_proceed"
                message="OT Takeoff: hovering until Proceed (at most 60 s)"
                log_level="1"
            />

            <!-- The Proceed check runs before the hover on every tick; when it
                 succeeds the running hover is halted (a controlled stop). A
                 failing hover fails the mode. -->
            <ReactiveFallback name="hover_until_proceed">
                <Sequence name="proceed_requested">
                    <ApplyPendingIntentUpdates name="apply_pending_cycle_intents"/>
                    <BlackboardBool name="proceed_flag_set" flag="opti_track.proceed" expected="true"/>
                </Sequence>
                <Sequence name="hover_then_land_without_proceed">
                    <Action
                        ID="Hover"
                        name="hover_waiting_for_proceed"
                        duration_s="60"
                        sustain_action="true"
                    />
                    <Action
                        ID="LogMessage"
                        name="log_no_proceed"
                        message="OT Cycle: no Proceed within 60 s, landing"
                        log_level="2"
                    />
                    <SetBlackboardBool name="request_cycle_land_now" flag="opti_track.cycle_land_now" value="true"/>
                </Sequence>
            </ReactiveFallback>

        </Sequence>
    </BehaviorTree>
</root>
