<root BTCPP_format="4" main_tree_to_execute="OptiTrackCycleLand">
    <!-- OT Land (mission opti-track-cycle, last mode): PX4 lands the vehicle
         where it is; PX4 disarms it after landing. -->
    <BehaviorTree ID="OptiTrackCycleLand">
        <Sequence name="ot_cycle_land_sequence">

            <!-- Reuses the run's recording (or starts one when this mode is
                 selected directly). -->
            <StartRosbagRecording
                name="ensure_cycle_recording"
                recording_id="opti_track_cycle"
                all_topics="false"
                topics="/fmu/out/vehicle_status_v1,
                        /fmu/out/vehicle_odometry,
                        /fmu/out/vehicle_local_position,
                        /fmu/out/vehicle_land_detected,
                        /fmu/out/failsafe_flags,
                        /fmu/out/estimator_status_flags,
                        /fmu/out/timesync_status,
                        /fmu/out/manual_control_setpoint,
                        /fmu/out/vehicle_command_ack,
                        /fmu/in/vehicle_command,
                        /fmu/in/vehicle_command_mode_executor,
                        /fmu/in/trajectory_setpoint,
                        /fmu/in/config_overrides_request,
                        /fmu/in/mode_completed,
                        /fmu/in/vehicle_visual_odometry,
                        /opti_track/pose_relay/health,
                        /control/maneuver_controller/reference,
                        /control/maneuver_controller/reference_mode,
                        /control/maneuver_controller/current_maneuver,
                        /control/maneuver_controller/maneuver_queue,
                        /control/trajectory_generator/trajectory_path,
                        /mission/mission_executor/maneuver_reference_client/reference_mode,
                        /mission/status,
                        /mission/modes/ot_cycle_takeoff/status,
                        /mission/modes/ot_cycle_shuttle/status,
                        /mission/modes/ot_cycle_land/status,
                        /tf,
                        /tf_static,
                        /rosout"
                include_hidden_topics="false"
                owner="mission"
            />

            <Action
                ID="LogMessage"
                name="log_landing"
                message="OT Land: landing"
                log_level="1"
            />

            <Action
                ID="ModeExecutorAction"
                name="land"
                action_request_type="2"
            />

            <Action
                ID="LogMessage"
                name="log_landed"
                message="OT Land: landed"
                log_level="1"
            />

        </Sequence>
    </BehaviorTree>
</root>
