<root BTCPP_format="4" main_tree_to_execute="OptiTrackModeLoopLowerStop">
    <!-- OT Lower Stop-and-Go (mission opti-track-mode-loop).

         Stop-and-go around the rectangle at the lower altitude
         (1.2 m): stop and hover 1 s at every corner, ending at A.
         Next mode: OT Upper Stop-and-Go. -->
    <BehaviorTree ID="OptiTrackModeLoopLowerStop">
        <Sequence name="otl_lower_stop_sequence">

            <!-- Geometry: rectangle corners A (+x,+y), B (-x,+y), C (-x,-y),
                 D (+x,-y) in the world frame (metres) at this mode's
                 altitude, heading fixed at yaw 0 (radians). Every mode tree
                 of this mission carries the same corners. Adapt to the cage
                 here. -->
            <SetBlackboard name="set_corner_a" output_key="corner_a" value="0.6,0.4,1.2"/>
            <SetBlackboard name="set_corner_b" output_key="corner_b" value="-0.6,0.4,1.2"/>
            <SetBlackboard name="set_corner_c" output_key="corner_c" value="-0.6,-0.4,1.2"/>
            <SetBlackboard name="set_corner_d" output_key="corner_d" value="0.6,-0.4,1.2"/>
            <SetBlackboard name="set_yaw_zero" output_key="yaw_zero" value="0"/>

            <!-- Reuses the run's recording (or starts one when this mode is
                 selected directly). -->
            <StartRosbagRecording
                name="ensure_mode_loop_recording"
                recording_id="opti_track_mode_loop"
                all_topics="false"
                topics="/fmu/out/vehicle_status_v1,
                        /fmu/out/vehicle_odometry,
                        /fmu/out/vehicle_local_position,
                        /fmu/out/vehicle_land_detected,
                        /fmu/out/failsafe_flags,
                        /fmu/out/estimator_status_flags,
                        /fmu/out/timesync_status,
                        /fmu/out/manual_control_setpoint,
                        /fmu/out/vehicle_command_ack,
                        /fmu/in/vehicle_command,
                        /fmu/in/vehicle_command_mode_executor,
                        /fmu/in/trajectory_setpoint,
                        /fmu/in/config_overrides_request,
                        /fmu/in/mode_completed,
                        /fmu/in/vehicle_visual_odometry,
                        /opti_track/pose_relay/health,
                        /control/maneuver_controller/reference,
                        /control/maneuver_controller/reference_mode,
                        /control/maneuver_controller/current_maneuver,
                        /control/maneuver_controller/maneuver_queue,
                        /control/trajectory_generator/trajectory_path,
                        /mission/mission_executor/maneuver_reference_client/reference_mode,
                        /mission/status,
                        /mission/modes/otl_takeoff/status,
                        /mission/modes/otl_lower_stop/status,
                        /mission/modes/otl_upper_stop/status,
                        /mission/modes/otl_lower_blend/status,
                        /mission/modes/otl_upper_blend/status,
                        /tf,
                        /tf_static,
                        /rosout"
                include_hidden_topics="false"
                owner="mission"
            />

            <Action ID="FlyToPosition" name="leg_1_to_corner_a" frame_id="world" target_position="{corner_a}" target_yaw="{yaw_zero}"/>
            <Action ID="Hover" name="hover_after_leg_1" duration_s="1" sustain_action="true"/>
            <Action ID="FlyToPosition" name="leg_2_to_corner_b" frame_id="world" target_position="{corner_b}" target_yaw="{yaw_zero}"/>
            <Action ID="Hover" name="hover_after_leg_2" duration_s="1" sustain_action="true"/>
            <Action ID="FlyToPosition" name="leg_3_to_corner_c" frame_id="world" target_position="{corner_c}" target_yaw="{yaw_zero}"/>
            <Action ID="Hover" name="hover_after_leg_3" duration_s="1" sustain_action="true"/>
            <Action ID="FlyToPosition" name="leg_4_to_corner_d" frame_id="world" target_position="{corner_d}" target_yaw="{yaw_zero}"/>
            <Action ID="Hover" name="hover_after_leg_4" duration_s="1" sustain_action="true"/>
            <Action ID="FlyToPosition" name="leg_5_to_corner_a" frame_id="world" target_position="{corner_a}" target_yaw="{yaw_zero}"/>
            <Action ID="Hover" name="hover_after_leg_5" duration_s="1" sustain_action="true"/>

        </Sequence>
    </BehaviorTree>
</root>
