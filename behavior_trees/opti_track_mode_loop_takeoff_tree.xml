<root BTCPP_format="4" main_tree_to_execute="OptiTrackModeLoopTakeoff">
    <!-- OT Loop Takeoff (mission opti-track-mode-loop, executor-owned mode).

         The mission executor arms a disarmed vehicle when this mode is
         selected. On the ground the tree requests a takeoff; when PX4
         already reports the vehicle airborne it skips the takeoff. Without a
         global position PX4 climbs to its default takeoff altitude
         (MIS_TAKEOFF_ALT) instead of the requested one. The vehicle then
         flies to corner A at the lower altitude.

         After this mode the mission loops forever through OT Lower
         Stop-and-Go, OT Upper Stop-and-Go, OT Lower Blended and OT Upper
         Blended; the pilot or the ground control ends it with a mode change.

         The recording started here (owner "mission") covers every mode of
         the run; the runtime finalizes it once PX4 takes control, as for the
         canonical inspection recording. -->
    <BehaviorTree ID="OptiTrackModeLoopTakeoff">
        <Sequence name="otl_takeoff_sequence">

            <!-- Geometry: world frame (metres), yaw in radians. Corner A of
                 the loop rectangle at the lower altitude. Adapt to the cage
                 here. -->
            <SetBlackboard name="set_takeoff_altitude" output_key="takeoff_altitude" value="1.2"/>
            <SetBlackboard name="set_corner_a" output_key="corner_a" value="0.6,0.4,1.2"/>
            <SetBlackboard name="set_yaw_zero" output_key="yaw_zero" value="0"/>

            <!-- One recording for the whole run. -->
            <StartRosbagRecording
                name="start_mode_loop_recording"
                recording_id="opti_track_mode_loop"
                all_topics="false"
                topics="/fmu/out/vehicle_status_v1,
                        /fmu/out/vehicle_odometry,
                        /fmu/out/vehicle_local_position,
                        /fmu/out/vehicle_land_detected,
                        /fmu/out/failsafe_flags,
                        /fmu/out/estimator_status_flags,
                        /fmu/out/timesync_status,
                        /fmu/out/manual_control_setpoint,
                        /fmu/out/vehicle_command_ack,
                        /fmu/in/vehicle_command,
                        /fmu/in/vehicle_command_mode_executor,
                        /fmu/in/trajectory_setpoint,
                        /fmu/in/config_overrides_request,
                        /fmu/in/mode_completed,
                        /fmu/in/vehicle_visual_odometry,
                        /opti_track/pose_relay/health,
                        /control/maneuver_controller/reference,
                        /control/maneuver_controller/reference_mode,
                        /control/maneuver_controller/current_maneuver,
                        /control/maneuver_controller/maneuver_queue,
                        /control/trajectory_generator/trajectory_path,
                        /mission/mission_executor/maneuver_reference_client/reference_mode,
                        /mission/status,
                        /mission/modes/otl_takeoff/status,
                        /mission/modes/otl_lower_stop/status,
                        /mission/modes/otl_upper_stop/status,
                        /mission/modes/otl_lower_blend/status,
                        /mission/modes/otl_upper_blend/status,
                        /tf,
                        /tf_static,
                        /rosout"
                include_hidden_topics="false"
                owner="mission"
            />

            <Fallback name="take_off_unless_airborne">
                <Action
                    ID="WaitForPX4Airborne"
                    name="already_airborne"
                    hold_ms="500"
                    timeout_ms="1500"
                />
                <Sequence name="take_off_from_the_ground">
                    <Action
                        ID="LogMessage"
                        name="log_taking_off"
                        message="OT Loop Takeoff: on the ground, taking off"
                        log_level="1"
                    />
                    <Action
                        ID="ModeExecutorAction"
                        name="take_off"
                        action_request_type="1"
                        takeoff_altitude="{takeoff_altitude}"
                    />
                    <Action
                        ID="WaitForPX4Airborne"
                        name="airborne_after_takeoff"
                        hold_ms="1000"
                        timeout_ms="8000"
                    />
                </Sequence>
            </Fallback>

            <Action ID="FlyToPosition" name="fly_to_corner_a" frame_id="world" target_position="{corner_a}" target_yaw="{yaw_zero}"/>
            <Action ID="Hover" name="hover_at_corner_a" duration_s="2" sustain_action="true"/>

        </Sequence>
    </BehaviorTree>
</root>
